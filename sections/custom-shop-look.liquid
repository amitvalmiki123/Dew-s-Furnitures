<section class="section section--bone" aria-labelledby="edit-title">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow"><i class="dew" aria-hidden="true"></i> {{ section.settings.eyebrow }}</p>
        <h2 id="edit-title">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="looks">
      {%- for block in section.blocks -%}
        <article class="look {% if forloop.index == 2 %}look--offset{% endif %} reveal" style="--d:.1s" {{ block.shopify_attributes }}>
          <div class="look__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', decoding: 'async' }}
            {%- else -%}
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag }}
            {%- endif -%}
            <p class="look__tag"><i class="dew dew--sm" aria-hidden="true"></i> {{ block.settings.tag_text }}</p>
          </div>

          <div class="look__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>

            <ul class="look__items">
              {%- assign product_1 = block.settings.product_1 -%}
              {%- if product_1 != blank -%}
                <li>
                  <a href="{{ product_1.url }}">
                    <img src="{{ product_1.featured_image | image_url: width: 100 }}" alt="{{ product_1.title }}" width="48" height="48" loading="lazy">
                    <span class="look__item-name">{{ product_1.title }}</span>
                    <span class="look__item-price">{{ product_1.price | money }}</span>
                  </a>
                </li>
              {%- endif -%}

              {%- assign product_2 = block.settings.product_2 -%}
              {%- if product_2 != blank -%}
                <li>
                  <a href="{{ product_2.url }}">
                    <img src="{{ product_2.featured_image | image_url: width: 100 }}" alt="{{ product_2.title }}" width="48" height="48" loading="lazy">
                    <span class="look__item-name">{{ product_2.title }}</span>
                    <span class="look__item-price">{{ product_2.price | money }}</span>
                  </a>
                </li>
              {%- endif -%}

              {%- assign product_3 = block.settings.product_3 -%}
              {%- if product_3 != blank -%}
                <li>
                  <a href="{{ product_3.url }}">
                    <img src="{{ product_3.featured_image | image_url: width: 100 }}" alt="{{ product_3.title }}" width="48" height="48" loading="lazy">
                    <span class="look__item-name">{{ product_3.title }}</span>
                    <span class="look__item-price">{{ product_3.price | money }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>

            <div class="look__foot">
              <span class="look__count">{{ block.settings.item_count_text }}</span>
              <a class="btn" href="{{ block.settings.btn_link }}">{{ block.settings.btn_text }} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Shop The Look",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Styled spaces"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Styled Look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main Image"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Image Tag Text",
          "default": "The Living Room Edit"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Warm, woven, welcoming"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Cane texture against espresso wood and ivory linen — layered so the room feels finished rather than furnished."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "item_count_text",
          "label": "Item Count Text",
          "default": "3 pieces in this look"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Shop this room"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Shop The Look",
      "blocks": [
        { "type": "look" },
        { "type": "look" }
      ]
    }
  ]
}
{% endschema %}