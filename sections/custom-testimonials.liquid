<section class="section section--bone" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow"><i class="dew" aria-hidden="true"></i> {{ section.settings.eyebrow }}</p>
        <h2 id="reviews-title">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="reviews">
      {%- for block in section.blocks -%}
        <div class="review reveal" style="--d:.0{{ forloop.index0 | times: 4 }}s" {{ block.shopify_attributes }}>
          <p class="stars" aria-hidden="true">★★★★★</p>
          <p class="review__body">“{{ block.settings.review_text }}”</p>
          <div class="review__foot">
            <div class="review__avatar">{{ block.settings.author_initials }}</div>
            <div>
              <p class="review__name">{{ block.settings.author_name }}</p>
              <p class="review__verified"><svg aria-hidden="true"><use href="#i-check"/></svg> Verified buyer</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Testimonials",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "From our customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people are saying"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "The cane work on the back of the armchair is even tighter in person. It feels substantial without being bulky in a small apartment."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Ananya S."
        },
        {
          "type": "text",
          "id": "author_initials",
          "label": "Author Initials",
          "default": "AS"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials",
      "blocks": [
        { "type": "review", "settings": { "author_name": "Ananya S.", "author_initials": "AS", "review_text": "The cane work on the back of the armchair is even tighter in person. It feels substantial without being bulky in a small apartment." } },
        { "type": "review", "settings": { "author_name": "Vikram M.", "author_initials": "VM", "review_text": "We bought the coffee table and matching sideboard. The sheesham grain has so much warmth under the lamp light. Delivery was extremely professional." } },
        { "type": "review", "settings": { "author_name": "Rohan & Neha", "author_initials": "RN", "review_text": "Finally furniture that doesn't look like flat-pack cardboard. Solid wood smells incredible when you unbox it." } }
      ]
    }
  ]
}
{% endschema %}